{
  "name": "dsh-science-review",
  "version": "0.3.0",
  "description": "核对 DeepSeek Harness 会话回答与执行记录的独立审查插件",
  "author": "SPYfighting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPYfighting/dsh-science-review.git"
  },
  "homepage": "https://github.com/SPYfighting/dsh-science-review#readme",
  "bugs": "https://github.com/SPYfighting/dsh-science-review/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "scientific-review"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/dsh-integration.mjs",
    "prepack": "npm run build",
    "dsh": "node scripts/project-dsh.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "esbuild": "0.25.12"
  }
}
